---
import Layout from "../layouts/Layout.astro"
import certificationsData from "./certifications.json"
const categorias = certificationsData.certificaciones
---

<Layout title="Certifications">
  <div
    class="flex flex-col items-start mx-auto p-4 min-h-screen bg-[#E4E0E0] dark:bg-gray-900"
  >
    <div
      class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mx-auto p-8"
    >
      <h1 class="text-3xl font-bold text-blue-900 mb-8 text-center">
        Certificaciones y Cursos
      </h1>
      {
        categorias.map((cat) => (
          <div class="mb-10">
            <h2 class="text-2xl font-semibold text-blue-900 mb-4">
              {cat.categoria}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {cat.items.map((item) => (
                <div class="bg-white border border-gray-200 rounded-lg shadow-md p-6 flex flex-col justify-between">
                  <div>
                    <h3 class="text-lg font-semibold text-blue-900 mb-2">
                      {item.nombre}
                    </h3>
                    <p class="text-gray-700 mb-1">{item.institucion}</p>
                    <p class="text-gray-500 text-sm mb-2">{item.fecha}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
