---
import Layout from "../layouts/Layout.astro"
import certifications from "./certifications.json"

// Transformar el objeto plano en un array de categorías
const categorias = Object.keys(certifications)
const totalCertificados = categorias.reduce(
  (acc, cat) => acc + (certifications as any)[cat].length,
  0
)
---

<Layout title="Certifications">
  <div
    class="flex flex-col items-start mx-auto p-4 min-h-screen bg-[#E4E0E0] dark:bg-gray-900"
  >
    <div
      class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mx-auto p-8"
    >
      <h1 class="text-3xl font-bold text-blue-900 mb-8 text-center">
        Certificaciones y Educación
      </h1>
      <p
        class="mb-8 text-lg text-neutral-700 dark:text-neutral-300 text-center"
      >
        He obtenido un total de {totalCertificados} certificados, cursos, títulos
        y reconocimientos a lo largo de mi trayectoria profesional y académica.
      </p>
      <main>
        {
          categorias.map((categoria) => (
            <section class="mb-8" id={categoria.replace(/\s+/g, "-")}>
              <h2 class="text-2xl font-semibold mb-4">{categoria}</h2>
              <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {(certifications as any)[categoria].map((cert: any) => (
                  <li class="bg-white/80 dark:bg-neutral-900 rounded-lg shadow p-4 border border-neutral-200 dark:border-neutral-700">
                    <div class="font-bold text-lg">{cert.Título}</div>
                    <div class="text-sm text-neutral-600 dark:text-neutral-300">
                      {cert.Entidad}
                    </div>
                    <div class="text-xs text-neutral-500 dark:text-neutral-400">
                      {cert.Tipo} &bull; {cert.Año}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </main>
    </div>
  </div>
</Layout>
