---
import Layout from "../layouts/Layout.astro"
import certifications from "./certifications.json"

// Transformar el objeto plano en un array de categorías
const categorias = Object.keys(certifications)
const totalCertificados = categorias.reduce(
  (acc, cat) => acc + (certifications as any)[cat].length,
  0
)

// Mapeo de títulos de categorías al inglés
const categoryTitles: Record<string, string> = {
  "Educación Formal": "Formal Education",
  "Liderazgo, Productividad y Gestión de Proyectos":
    "Leadership, Productivity & Project Management",
  "Desarrollo de Software y Programación": "Software Development & Programming",
  "Cloud Computing y DevOps": "Cloud Computing & DevOps",
  "Bases de Datos y Big Data": "Databases & Big Data",
  "Seguridad Informática": "Cybersecurity",
  "Inteligencia Artificial y Machine Learning":
    "Artificial Intelligence & Machine Learning",
  "Redes y Telecomunicaciones": "Networks & Telecommunications",
  "Gestión de Calidad y Metodologías": "Quality Management & Methodologies",
  Idiomas: "Languages",
  Otros: "Others",
}
---

<Layout title="Certifications">
  <div class="flex flex-col items-center justify-center mx-auto p-4 space-y-6">
    <div
      class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
    >
      <div class="flex flex-col items-center pb-10 mt-8 px-4">
        <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
          >Certifications & Education</span
        >
        <hr class="w-full max-w-md mb-6" />
        <p
          class="mb-8 text-sm md:text-lg text-neutral-700 dark:text-neutral-300 text-center px-4"
        >
          I have obtained a total of {totalCertificados} certificates, courses, degrees
          and recognitions throughout my professional and academic career.
        </p>
        <main class="w-full">
          {
            categorias.map((categoria) => (
              <section class="mb-8" id={categoria.replace(/\s+/g, "-")}>
                <h2 class="text-lg md:text-2xl font-semibold mb-6 text-center">
                  {categoryTitles[categoria] || categoria}
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                  {(certifications as any)[categoria].map((cert: any) => (
                    <div class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200">
                      <div class="flex items-start justify-between">
                        <div class="flex-1">
                          <div class="flex items-center mb-2">
                            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 dark:bg-blue-900">
                              <svg
                                class="w-4 h-4 text-blue-600 dark:text-blue-300"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                                />
                              </svg>
                            </div>
                            <div>
                              <h3 class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300">
                                {cert.Título}
                              </h3>
                              <p class="text-xs text-gray-600 dark:text-gray-400">
                                {cert.Entidad}
                              </p>
                            </div>
                          </div>
                          <p class="text-xs text-gray-500 dark:text-gray-500">
                            {cert.Tipo} • {cert.Año}
                          </p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))
          }
        </main>
      </div>
    </div>
  </div>
</Layout>
