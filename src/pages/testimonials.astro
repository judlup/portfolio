---
import Icon from "astro-icon"
import { Image } from "astro:assets"
import AndresPardo from "../assets/img/andrespardo.jpeg"
import EdgarAcosta from "../assets/img/edgaracosta.jpeg"
import JonMaddogHall from "../assets/img/jonmaddoghall.jpeg"
import JuanDiegoHenao from "../assets/img/juanhenao.jpg"
import SaulVega from "../assets/img/saulvega.jpeg"
import XimenaHoffman from "../assets/img/ximenahoffman.jpeg"
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"

const testimonials = [
  {
    name: 'Jon "Maddong" Hall',
    picture: JonMaddogHall,
    role: "Board Chair",
    company: "Linux Professional Institute",
    reference:
      "I have known Julian since he was in high school. He created a home automation project where he could control a whole model house from his android tablet, and it was extremely impressive. I gave him a Raspberry Pi to work into his model, which he did in a few weeks.",
    highlight: "Extremely impressive"
  },
  {
    name: "Ximena Hoffmann",
    picture: XimenaHoffman,
    role: "Change Network Lead",
    company: "NEC Corporation",
    reference:
      "I had the opportunity to work with Julian at NEC, and he always proved to be a natural leader, with an excellent service attitude at all times. He is the kind of professional who helps to build as a team and find various ways to achieve the necessary results.",
    highlight: "Natural leader"
  },
  {
    name: "Andrés Pardo",
    picture: AndresPardo,
    role: "Key Account Manager - Large Accounts",
    company: "Tatic",
    reference:
      "Julian is a quite active engineer, not only proficient in SW development arena, but also displays very good leading abilities adequate to lead agile teams. He's quite self driven, propositive, creative and has a entreprenurship mentality. Is always active, connecting, integrating, supporting, alwasy worried to help teams to be more effective. His personal skills are strengths helping him and his peers to build very productive teams and beat obstacles.",
    highlight: "Entrepreneurship mentality"
  },
  {
    name: "Juan Diego Henao",
    picture: JuanDiegoHenao,
    role: "Desarrollador de Software",
    company: "Codesa",
    reference:
      "Julian Dario was a very important person for my professional development, demonstrating excellent leadership and broad knowledge in his field. With little help from others, he was capable of dealing with all the obstacles that stood in his way, with great organization and quality. He is a team player, always willing to help, and seldom has a bad response for others.",
    highlight: "Excellent leadership"
  },
  {
    name: "Edgar Acosta",
    picture: EdgarAcosta,
    role: "Delivery and Operations Head",
    company: "NEC de Colombia",
    reference:
      "I had the good opportunity to get to know Julian at his period working for NEC. His work was of very positive and opportune impact for the projects my team was developing. I totally recommend Julian as an excellent resource for different kind of projects. Julie is a very creative person with a positive and 'Can Do' attitude all the time.",
    highlight: "Can Do attitude"
  },
  {
    name: "Saúl Verga Ramírez",
    picture: SaulVega,
    role: "Software Engineer",
    company: "Rappi",
    reference:
      "Julian is a leader with a great ability to lead any team he is part of to success, as he knows quite well how to harmonize the task of solving tasks while being empathetic with his team members, always understanding the needs of each of his colleagues whom he leads, and knowing how to unite them to pool efforts and recognizing everyone's work. He also knows how to manage in relation to stakeholders and external teams and to communicate the requirements in such a way that his team can understand.",
    highlight: "Great ability to lead"
  },
]
---

<Layout title="Testimonials">
  <div class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mb-2 mx-auto mt-8">
    <!-- Hero Section -->
    <div class="relative overflow-hidden">
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="text-center">
          <h1 class="text-4xl md:text-6xl font-bold text-blue-900 dark:text-blue-400 mb-4">
            What People Say
          </h1>
          <p class="text-xl text-blue-900 dark:text-blue-400 max-w-3xl mx-auto mb-4">
            Discover what colleagues, mentors, and industry leaders have to say about my work, 
            leadership, and contributions to the tech community.
          </p>
        </div>
      </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          testimonials.map((testimonial, idx) => (
            <div class="group relative">
              <!-- Card -->
              <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 p-8 h-full border border-gray-200 dark:border-gray-700 group-hover:border-blue-200 dark:group-hover:border-blue-600">
                <!-- Quote Icon -->
                <div class="absolute -top-4 left-8">
                  <div class="w-8 h-8 bg-blue-900 rounded-full flex items-center justify-center">
                    <Icon name="mdi:format-quote-close" class="w-4 h-4 text-white" />
                  </div>
                </div>

                <!-- Highlight -->
                <div class="mb-6">
                  <span class="inline-block bg-blue-100 dark:bg-blue-900/30 text-blue-900 dark:text-blue-200 text-sm font-semibold px-3 py-1 rounded-full">
                    "{testimonial.highlight}"
                  </span>
                </div>

                <!-- Testimonial Text Preview -->
                <blockquote class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed mb-4 italic">
                  <span id={`testimonial-preview-${idx}`}></span>
                </blockquote>

                <!-- Collapse Section -->
                <div class="overflow-hidden transition-all duration-300 ease-in-out" id={`collapse-${idx}`} style="max-height: 0;">
                  <div class="pt-4 border-t border-gray-200 dark:border-gray-600">
                    <blockquote class="text-gray-600 dark:text-gray-400 text-base leading-relaxed italic">
                      <span id={`testimonial-full-${idx}`}></span>
                    </blockquote>
                  </div>
                </div>

                <!-- Toggle Button -->
                <div class="mb-4">
                  <button
                    class="inline-flex items-center text-blue-900 hover:text-blue-700 text-sm font-semibold focus:outline-none transition-colors duration-200"
                    type="button"
                    onclick={`toggleCollapse(${idx})`}
                    id={`collapse-btn-${idx}`}
                  >
                    <span>Ver detalle</span>
                    <Icon name="mdi:chevron-down" class="w-4 h-4 ml-1 transition-transform duration-200" id={`chevron-${idx}`} />
                  </button>
                </div>

                <!-- Author Info -->
                <div class="flex items-center space-x-4">
                  <div class="relative">
                    <Image
                      src={testimonial.picture}
                      alt={testimonial.name}
                      class="w-16 h-16 rounded-full object-cover ring-4 ring-blue-100 dark:ring-blue-900/30 group-hover:ring-blue-900 dark:group-hover:ring-blue-900 transition-all duration-300"
                    />
                    <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 rounded-full border-2 border-white dark:border-gray-800"></div>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                      {testimonial.name}
                    </h3>
                    <p class="text-sm text-blue-900 dark:text-blue-400 font-medium">
                      {testimonial.role}
                    </p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                      {testimonial.company}
                    </p>
                  </div>
                </div>
              </div>

              <!-- Decorative Elements -->
              <div class="absolute -top-2 -right-2 w-4 h-4 bg-blue-900 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute -bottom-2 -left-2 w-3 h-3 bg-blue-900 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100"></div>
            </div>
          ))
        }
      </div>

      <!-- CTA Section -->
      <div class="text-center mt-16">
        <div class="bg-blue-900 rounded-2xl p-8 md:p-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Want to see more recommendations?
          </h2>
          <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
            Explore my complete collection of professional recommendations and endorsements on LinkedIn.
          </p>
          <a
            href="https://www.linkedin.com/in/judlup/details/recommendations/?detailScreenTabIndex=0"
            target="_blank"
            class="inline-flex items-center px-8 py-4 bg-white text-blue-900 font-semibold rounded-xl hover:bg-blue-50 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
          >
            <Icon name="mdi:linkedin" class="w-6 h-6 mr-3" />
            View All Recommendations
            <Icon name="mdi:arrow-right" class="w-5 h-5 ml-3" />
          </a>
        </div>
      </div>
    </div>

    <!-- Floating Elements -->
    <div class="fixed top-20 left-10 w-2 h-2 bg-blue-900 rounded-full animate-pulse opacity-50"></div>
    <div class="fixed top-40 right-20 w-3 h-3 bg-blue-900 rounded-full animate-pulse opacity-30"></div>
    <div class="fixed bottom-40 left-20 w-2 h-2 bg-blue-900 rounded-full animate-pulse opacity-40"></div>
  </div>

  <script is:inline>
    // Testimonials data
    const testimonialsData = [
      "I have known Julian since he was in high school. He created a home automation project where he could control a whole model house from his android tablet, and it was extremely impressive. I gave him a Raspberry Pi to work into his model, which he did in a few weeks.",
      "I had the opportunity to work with Julian at NEC, and he always proved to be a natural leader, with an excellent service attitude at all times. He is the kind of professional who helps to build as a team and find various ways to achieve the necessary results.",
      "Julian is a quite active engineer, not only proficient in SW development arena, but also displays very good leading abilities adequate to lead agile teams. He's quite self driven, propositive, creative and has a entreprenurship mentality. Is always active, connecting, integrating, supporting, alwasy worried to help teams to be more effective. His personal skills are strengths helping him and his peers to build very productive teams and beat obstacles.",
      "Julian Dario was a very important person for my professional development, demonstrating excellent leadership and broad knowledge in his field. With little help from others, he was capable of dealing with all the obstacles that stood in his way, with great organization and quality. He is a team player, always willing to help, and seldom has a bad response for others.",
      "I had the good opportunity to get to know Julian at his period working for NEC. His work was of very positive and opportune impact for the projects my team was developing. I totally recommend Julian as an excellent resource for different kind of projects. Julie is a very creative person with a positive and 'Can Do' attitude all the time.",
      "Julian is a leader with a great ability to lead any team he is part of to success, as he knows quite well how to harmonize the task of solving tasks while being empathetic with his team members, always understanding the needs of each of his colleagues whom he leads, and knowing how to unite them to pool efforts and recognizing everyone's work. He also knows how to manage in relation to stakeholders and external teams and to communicate the requirements in such a way that his team can understand."
    ];

    // Initialize testimonials
    document.addEventListener('DOMContentLoaded', function() {
      testimonialsData.forEach((text, idx) => {
        const previewEl = document.getElementById(`testimonial-preview-${idx}`);
        const fullEl = document.getElementById(`testimonial-full-${idx}`);
        const btn = document.getElementById(`collapse-btn-${idx}`);
        
        if (previewEl && fullEl) {
          const lines = text.split(/\r?\n/);
          if (lines.length > 7) {
            previewEl.textContent = lines.slice(0, 7).join("\n") + "...";
            fullEl.textContent = text;
            if (btn) btn.style.display = "inline-flex";
          } else {
            previewEl.textContent = text;
            fullEl.textContent = text;
            if (btn) btn.style.display = "none";
          }
        }
      });
    });

    // Toggle collapse function
    window.toggleCollapse = function(idx) {
      const collapseEl = document.getElementById(`collapse-${idx}`);
      const btn = document.getElementById(`collapse-btn-${idx}`);
      const chevron = document.getElementById(`chevron-${idx}`);
      
      if (!collapseEl || !btn || !chevron) return;
      
      const isExpanded = collapseEl.style.maxHeight !== "0px" && collapseEl.style.maxHeight !== "";
      
      if (isExpanded) {
        // Collapse
        collapseEl.style.maxHeight = "0px";
        btn.querySelector('span').textContent = "Ver detalle";
        chevron.style.transform = "rotate(0deg)";
      } else {
        // Expand
        collapseEl.style.maxHeight = collapseEl.scrollHeight + "px";
        btn.querySelector('span').textContent = "Ocultar detalle";
        chevron.style.transform = "rotate(180deg)";
      }
    };
  </script>
</Layout>
