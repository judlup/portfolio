// Agrupar por año
const talksByYear: Record<string, Talk[]> = talks.reduce(
  (acc: Record<string, Talk[]>, talk: Talk) => {
    if (!acc[talk.year]) {
      acc[talk.year] = []
    }
    acc[talk.year].push(talk)
    return acc
  },
  {}
)

// Ordenar años de más reciente a más antiguo
const sortedYears: string[] = Object.keys(talksByYear).sort(
  (a: string, b: string) => parseInt(b) - parseInt(a)
)

// Ordenar charlas por fecha dentro de cada año (más reciente primero)
sortedYears.forEach((year) => {
  talksByYear[year].sort((a, b) => {
    const dateA = new Date(a.date.split("/").reverse().join("-"))
    const dateB = new Date(b.date.split("/").reverse().join("-"))
    return dateB.getTime() - dateA.getTime()
  })
})
---

<Layout title="Charlas, Conferencias y Publicaciones">
  <div class="flex flex-col items-center justify-center mx-auto p-4 space-y-6">
    <div
      class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
    >
      <div class="flex flex-col items-center pb-10 mt-8 px-4">
        <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
          >Talks, Conferences & Publications</span
        >
        <hr class="w-full max-w-md mb-6" />

        <div class="w-full space-y-8">
          {
            sortedYears.map((year) => (
              <div class="space-y-4">
                <h2 class="text-lg md:text-2xl font-semibold text-blue-800 border-b-2 border-blue-200 pb-2 text-center">
                  {year}
                </h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
                  {talksByYear[year].map((talk) => (
                    <div class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200">
                      <div class="flex items-start justify-between">
                        <div class="flex-1">
                          <div class="flex items-center mb-2">
                            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 dark:bg-blue-900">
                              <svg
                                class="w-4 h-4 text-blue-600 dark:text-blue-300"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                                />
                              </svg>
                            </div>
                            <div>
                              <h3 class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300 line-clamp-2">
                                {talk.title}
                              </h3>
                              <p class="text-xs text-gray-600 dark:text-gray-400">
                                {talk.event}
                              </p>
                            </div>
                          </div>
                          <p class="text-xs text-gray-500 dark:text-gray-500">
                            {talk.date}
                          </p>
                        </div>
                        {talk.link && (
                          <a
                            href={talk.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="ml-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 flex-shrink-0"
                          >
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                              />
