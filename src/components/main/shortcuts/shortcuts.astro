---
const info = {
  shortcuts: [
    {
      name: "Skills",
      path: "/skills",
      icon: "ph:brain-light",
    },
    {
      name: "Experience",
      path: "/experience",
      icon: "mdi:work-outline",
    },
    {
      name: "Talks & Conferences",
      path: "/talks",
      icon: "mdi:microphone-variant",
    },
    {
      name: "Awards",
      path: "/awards",
      icon: "mdi:trophy",
    },
    {
      name: "Certifications",
      path: "/certifications",
      icon: "mdi:certificate",
    },
    {
      name: "Testimonials",
      path: "/testimonials",
      icon: "dashicons:testimonial",
    },
  ],
}
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8 px-4">
    <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
      >More about me</span
    >
    <hr class="w-full max-w-md mb-6" />

    <!-- Explore More Section -->
    <div class="w-full mb-8">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4"
      >
        <a
          href="/experience"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 dark:bg-blue-900"
                >
                  <svg
                    class="w-4 h-4 text-blue-600 dark:text-blue-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300"
                  >
                    Experience
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Trayectoria profesional
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/skills"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mr-3 dark:bg-green-900"
                >
                  <svg
                    class="w-4 h-4 text-green-600 dark:text-green-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-green-900 dark:text-green-300"
                  >
                    Skills
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Habilidades técnicas
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/talks"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3 dark:bg-purple-900"
                >
                  <svg
                    class="w-4 h-4 text-purple-600 dark:text-purple-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-purple-900 dark:text-purple-300"
                  >
                    Talks & Conferences
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Charlas y conferencias
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/awards"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-yellow-100 rounded-lg flex items-center justify-center mr-3 dark:bg-yellow-900"
                >
                  <svg
                    class="w-4 h-4 text-yellow-600 dark:text-yellow-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-yellow-900 dark:text-yellow-300"
                  >
                    Awards
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Premios y reconocimientos
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/certifications"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center mr-3 dark:bg-indigo-900"
                >
                  <svg
                    class="w-4 h-4 text-indigo-600 dark:text-indigo-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-indigo-900 dark:text-indigo-300"
                  >
                    Certifications
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Certificaciones profesionales
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/testimonials"
          class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div
                  class="w-8 h-8 bg-pink-100 rounded-lg flex items-center justify-center mr-3 dark:bg-pink-900"
                >
                  <svg
                    class="w-4 h-4 text-pink-600 dark:text-pink-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3
                    class="text-sm md:text-base font-semibold text-pink-900 dark:text-pink-300"
                  >
                    Testimonials
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    Referencias y testimonios
                  </p>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="w-full px-8 md:px-16">
      <div
        class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg border border-blue-200 dark:border-blue-700 p-6"
      >
        <h3
          class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3"
        >
          ¿Interesado en trabajar juntos?
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
          Estoy siempre abierto a nuevas oportunidades y colaboraciones. ¡No
          dudes en contactarme!
        </p>
        <a
          href="mailto:judlup@trycatch.tv"
          class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors duration-200"
        >
          <svg
            class="w-4 h-4 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          Contactar por Email
        </a>
      </div>
    </div>
  </div>
</div>
