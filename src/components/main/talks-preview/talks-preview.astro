---
// Talks Preview Component for Main Page
const featuredTalks = [
  {
    title: "GlassCamp: De la idea a producción con la comunidad",
    event: "AWS Community Day Colombia",
    date: "28/06/2025",
    link: null,
  },
  {
    title: "Story Telling para arquitectos de software",
    event: "AWS User Group Neiva",
    date: "11/06/2025",
    link: null,
  },
  {
    title: "Arquitectura de soluciones: el arte de no romper nada",
    event: "No Somos Devs",
    date: "06/06/2025",
    link: null,
  },
  {
    title:
      "Prepárate para el éxito: tips para trabajar en desarrollo de software",
    event: "SENA",
    date: "15/07/2025",
    link: "https://www.instagram.com/p/DLs_0WMRI0y/?utm_source=ig_web_copy_link",
  },
]
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8 px-4">
    <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
      >Latest Talks</span
    >
    <hr class="w-full max-w-md mb-6" />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 mt-6 w-full">
      {
        featuredTalks.map((talk) => (
          <div class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300 mb-1 line-clamp-2">
                  {talk.title}
                </h3>
                <p class="text-xs md:text-sm text-gray-600 dark:text-gray-400 mb-1">
                  {talk.event}
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-500">
                  {talk.date}
                </p>
              </div>
              {talk.link && (
                <a
                  href={talk.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ml-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 flex-shrink-0"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-6 md:mt-8">
      <a
        href="/talks"
        class="inline-flex items-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        <svg
          class="w-4 h-4 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
          ></path>
        </svg>
        View All Talks
      </a>
    </div>
  </div>
</div>
