          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 bg-slate-50 hover:bg-purple-50 rounded-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div
