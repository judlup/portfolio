---
// TryCatch.tv Featured Component for Main Page
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8 px-4">
    <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
      >TryCatch.tv</span
    >
    <hr class="w-full max-w-md mb-6" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 mt-6 w-full">
      <!-- Platform Card -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 dark:bg-blue-900"
              >
                <svg
                  class="w-4 h-4 text-blue-600 dark:text-blue-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300"
                >
                  Comunidad Tech LATAM
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  +90,000 personas alcanzadas
                </p>
              </div>
            </div>
            <p
              class="text-xs md:text-sm text-gray-700 dark:text-gray-300 mb-3 leading-relaxed"
            >
              Transformamos la forma de aprender, conectar y crecer en el mundo
              dev. Educación tech con propósito: desarrollo, arquitectura, soft
              skills y oportunidades de vida.
            </p>
            <div class="flex flex-wrap gap-1 mb-3">
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                +2,500 videos
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                400+ lives
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                Mentorías
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                Workshops
              </span>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">2022-Present</p>
          </div>
          <a
            href="https://trycatch.tv"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 flex-shrink-0"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- YouTube Channel Card -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center mr-3 dark:bg-red-900"
              >
                <svg
                  class="w-4 h-4 text-red-600 dark:text-red-300"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-red-900 dark:text-red-300"
                >
                  Canal de YouTube
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  +50,000 suscriptores
                </p>
              </div>
            </div>
            <p
              class="text-xs md:text-sm text-gray-700 dark:text-gray-300 mb-3 leading-relaxed"
            >
              Contenido educativo sobre desarrollo, arquitectura de software y
              mejores prácticas. Tutoriales, reviews y contenido técnico para la
              comunidad dev.
            </p>
            <div class="flex flex-wrap gap-1 mb-3">
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                +500 videos
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                +2M vistas
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                JavaScript
              </span>
              <span
                class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full dark:bg-gray-600 dark:text-gray-300"
              >
                AWS
              </span>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">2020-Present</p>
          </div>
          <a
            href="https://www.youtube.com/@TryCatch_tv/streams"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-2 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 flex-shrink-0"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Social Networks Section -->
    <div class="w-full mt-8 px-4">
      <h3
        class="text-lg font-semibold text-blue-900 dark:text-blue-300 mb-4 text-center"
      >
        Redes donde creo contenido
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <a
          href="https://www.youtube.com/@TryCatch_tv/streams"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 bg-slate-50 hover:bg-red-50 rounded-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div
            class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mb-2 dark:bg-red-900"
          >
            <svg
              class="w-5 h-5 text-red-600 dark:text-red-300"
              fill="currentColor"
              viewBox="0 0 24 24"
