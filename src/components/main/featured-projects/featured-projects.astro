          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 bg-slate-50 hover:bg-indigo-50 rounded-lg border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
        >
          <div
            class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center mb-2 dark:bg-indigo-900"
          >
            <svg
              class="w-5 h-5 text-indigo-600 dark:text-indigo-300"
