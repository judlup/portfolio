      <div class="text-center bg-slate-50 rounded-lg p-4 dark:bg-gray-700">
        <div class="text-2xl font-bold text-blue-900 dark:text-blue-300">
          +90K
        </div>
        <div class="text-xs text-gray-600 dark:text-gray-400">
          Personas alcanzadas
        </div>
      </div>
      <div class="text-center bg-slate-50 rounded-lg p-4 dark:bg-gray-700">
        <div class="text-2xl font-bold text-blue-900 dark:text-blue-300">
          +2.5K
        </div>
        <div class="text-xs text-gray-600 dark:text-gray-400">
