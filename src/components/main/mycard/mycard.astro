---
import { Icon } from "astro-icon"
import { Image } from "astro:assets"
import Judlup from "../../../assets/img/judlup.jpg"

const info = {
  name: "Julián Darío Luna Patiño",
  role: "Solutions Architect",
  secondRole: "AWS Community Builder",
  education: [
    "Content creator at TryCatch.tv",
    "Mg. Architectures of Information Technology",
    "Ph.D. Student in Technology Innovation Management",
  ],
  picture: Judlup,
  socialNetworks: [
    {
      name: "linkedin",
      url: "https://www.linkedin.com/in/judlup/",
      icon: "ri:linkedin-fill",
    },
    {
      name: "github",
      url: "https://github.com/judlup",
      icon: "mdi:github",
    },
    {
      name: "tik tok",
      url: "https://www.tiktok.com/@trycatch.tv/",
      icon: "ic:baseline-tiktok",
    },
    {
      name: "medium",
      url: "https://medium.com/@judlup",
      icon: "mdi:medium",
    },
    {
      name: "instagram",
      url: "https://instagram.com/judlup",
      icon: "ri:instagram-line",
    },
    {
      name: "youtube",
      url: "https://youtube.com/juliandario1006",
      icon: "mdi:youtube",
    },
    {
      name: "twitter",
      url: "https://twitter.com/judlup",
      icon: "mdi:twitter",
    },
  ],
  cv: {
    url: "https://www.linkedin.com/in/judlup/",
    icon: "bi:download",
  },
  email: {
    url: "mailto:judlup@trycatch.tv",
    icon: "mdi-light:email",
  },
}
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8 px-4">
    <Image
      class="w-24 h-24 md:w-48 md:h-48 mb-3 rounded-full shadow-lg"
      src={info.picture}
      alt="Judlup"
    />
    <h5
      class="mb-1 text-xl md:text-3xl font-medium text-gray-900 dark:text-white text-center"
    >
      {info.name}
    </h5>
    <span
      class="text-sm md:text-xl text-gray-500 dark:text-gray-400 text-center"
      >{info.role}</span
    >
    <span
      class="text-xs md:text-lg text-gray-500 dark:text-gray-400 text-center"
      >{info.secondRole}</span
    >
    <span
      class="text-xs md:text-lg text-gray-500 dark:text-gray-400 text-center"
      >{info.education[0]}</span
    >
    <span
      class="text-xs md:text-lg text-gray-500 dark:text-gray-400 text-center"
      >{info.education[1]}</span
    >
    <span
      class="text-xs md:text-lg text-gray-500 dark:text-gray-400 text-center"
      >{info.education[2]}</span
    >
    <div class="flex flex-col sm:flex-row mt-4 md:mt-6 gap-3">
      <a
        href={info.cv.url}
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
        ><Icon class="w-4 h-4" name={`${info.cv.icon}`} /><span class="ml-2"
          >Resume</span
        ></a
      >
      <a
        href={info.email.url}
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-center text-gray-900 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-700 dark:focus:ring-gray-700"
        ><Icon class="w-5 h-5" name={`${info.email.icon}`} /><span class="ml-2"
          >Contact me</span
        ></a
      >
    </div>
    <div>
      <ul class="flex mt-4 space-x-2 flex-wrap justify-center">
        {
          info.socialNetworks.map((socialNetwork) => (
            <li>
              <a
                href={socialNetwork.url}
                target="_blank"
                class="text-slate-400 rounded-full hover:text-blue-900 p-1"
              >
                <span class="sr-only">{socialNetwork.name}</span>
                <Icon class="w-6 h-6" name={`${socialNetwork.icon}`} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
