---
// Awards Preview Component for Main Page
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8">
    <span class="text-slate-900 font-bold md:text-2xl mb-8"
      >Awards & Recognitions</span
    >
    <hr />
    <div class="grid grid-cols-1 md:grid-cols-4 md:gap-16 mt-6">
      <!-- Capital Semilla -->
      <div
        class="group flex flex-col items-center bg-slate-100 hover:bg-blue-900 rounded-md h-30 w-52 justify-center cursor-pointer mb-2 md:mb-0"
      >
        <div
          class="flex flex-col items-center justify-center p-4 rounded-md dark:hover:bg-gray-700"
        >
          <div
            class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mb-2"
          >
            <svg
              class="w-5 h-5 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <span
            class="text-md text-blue-900 font-bold dark:text-gray-100 group-hover:text-white text-center"
          >
            Capital Semilla
          </span>
          <span
            class="text-xs text-gray-600 group-hover:text-gray-200 text-center"
          >
            Fondo Emprender
          </span>
        </div>
      </div>

      <!-- WorldSkills -->
      <div
        class="group flex flex-col items-center bg-slate-100 hover:bg-blue-900 rounded-md h-30 w-52 justify-center cursor-pointer mb-2 md:mb-0"
      >
        <div
          class="flex flex-col items-center justify-center p-4 rounded-md dark:hover:bg-gray-700"
        >
          <div
            class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mb-2"
          >
            <svg
              class="w-5 h-5 text-amber-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <span
            class="text-md text-blue-900 font-bold dark:text-gray-100 group-hover:text-white text-center"
          >
            WorldSkills
          </span>
          <span
            class="text-xs text-gray-600 group-hover:text-gray-200 text-center"
          >
            Bronze Medal IT/PC
          </span>
        </div>
      </div>

      <!-- Campus Party -->
      <div
        class="group flex flex-col items-center bg-slate-100 hover:bg-blue-900 rounded-md h-30 w-52 justify-center cursor-pointer mb-2 md:mb-0"
      >
        <div
          class="flex flex-col items-center justify-center p-4 rounded-md dark:hover:bg-gray-700"
        >
          <div
            class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center mb-2"
          >
            <svg
              class="w-5 h-5 text-purple-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <span
            class="text-md text-blue-900 font-bold dark:text-gray-100 group-hover:text-white text-center"
          >
            Campus Party
          </span>
          <span
            class="text-xs text-gray-600 group-hover:text-gray-200 text-center"
          >
            Featured Project 2012
          </span>
        </div>
      </div>

      <!-- Apps.co -->
      <div
        class="group flex flex-col items-center bg-slate-100 hover:bg-blue-900 rounded-md h-30 w-52 justify-center cursor-pointer mb-2 md:mb-0"
      >
        <div
          class="flex flex-col items-center justify-center p-4 rounded-md dark:hover:bg-gray-700"
        >
          <div
            class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mb-2"
          >
            <svg
              class="w-5 h-5 text-blue-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <span
            class="text-md text-blue-900 font-bold dark:text-gray-100 group-hover:text-white text-center"
          >
            Apps.co
          </span>
          <span
            class="text-xs text-gray-600 group-hover:text-gray-200 text-center"
          >
            Top 4 Santander
          </span>
        </div>
      </div>
    </div>

    <div class="text-center mt-8">
      <a
        href="/awards"
        class="inline-flex items-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="ml-2">View All Awards</span>
      </a>
    </div>
  </div>
</div>
