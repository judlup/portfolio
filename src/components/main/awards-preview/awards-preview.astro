---
// Awards Preview Component for Main Page
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8 px-4">
    <span class="text-slate-900 font-bold text-lg md:text-2xl mb-6"
      >Awards & Recognitions</span
    >
    <hr class="w-full max-w-md mb-6" />
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mt-6 w-full"
    >
      <!-- Capital Semilla -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mr-3 dark:bg-green-900"
              >
                <svg
                  class="w-4 h-4 text-green-600 dark:text-green-300"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-green-900 dark:text-green-300"
                >
                  Capital Semilla
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  Fondo Emprender
                </p>
              </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">
              Reconocimiento por emprendimiento
            </p>
          </div>
        </div>
      </div>

      <!-- WorldSkills -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center mr-3 dark:bg-amber-900"
              >
                <svg
                  class="w-4 h-4 text-amber-600 dark:text-amber-300"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-amber-900 dark:text-amber-300"
                >
                  WorldSkills
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  Bronze Medal IT/PC
                </p>
              </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">
              Competencia internacional
            </p>
          </div>
        </div>
      </div>

      <!-- Campus Party -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3 dark:bg-purple-900"
              >
                <svg
                  class="w-4 h-4 text-purple-600 dark:text-purple-300"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-purple-900 dark:text-purple-300"
                >
                  Campus Party
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  Featured Project 2012
                </p>
              </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">
              Festival de tecnología
            </p>
          </div>
        </div>
      </div>

      <!-- Apps.co -->
      <div
        class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center mb-2">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center mr-3 dark:bg-blue-900"
              >
                <svg
                  class="w-4 h-4 text-blue-600 dark:text-blue-300"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-sm md:text-base font-semibold text-blue-900 dark:text-blue-300"
                >
                  Apps.co
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400">
                  Top 4 Santander
                </p>
              </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-500">
              Programa de emprendimiento
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-6 md:mt-8">
      <a
        href="/awards"
        class="inline-flex items-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="ml-2">View All Awards</span>
      </a>
    </div>
  </div>
</div>
