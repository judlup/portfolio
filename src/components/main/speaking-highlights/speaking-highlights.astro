---
// Speaking Highlights Component for Main Page
const speakingStats = [
  {
    number: "50+",
    label: "Talks Given",
    icon: "microphone",
  },
  {
    number: "15+",
    label: "Countries",
    icon: "globe",
  },
  {
    number: "1000+",
    label: "People Reached",
    icon: "users",
  },
  {
    number: "10+",
    label: "Years Speaking",
    icon: "calendar",
  },
]

const upcomingTalks = [
  {
    title: "Arquitectura de soluciones: el arte de no romper nada",
    event: "No Somos Devs",
    date: "06/06/2025",
    location: "Virtual",
  },
  {
    title: "Story Telling para arquitectos de software",
    event: "AWS User Group Neiva",
    date: "11/06/2025",
    location: "Neiva, Colombia",
  },
]
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"
>
  <div class="flex flex-col items-center pb-10 mt-8">
    <span class="text-slate-900 font-bold md:text-2xl mb-8"
      >Speaking Highlights</span
    >
    <hr />

    <!-- Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-6 w-full px-4">
      {
        speakingStats.map((stat) => (
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3 dark:bg-blue-900">
              <svg
                class="w-8 h-8 text-blue-600 dark:text-blue-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                {stat.icon === "microphone" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                  />
                )}
                {stat.icon === "globe" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                )}
                {stat.icon === "users" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                  />
                )}
                {stat.icon === "calendar" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                )}
              </svg>
            </div>
            <div class="text-2xl font-bold text-blue-900 dark:text-blue-300 mb-1">
              {stat.number}
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Upcoming Talks -->
    <div class="w-full mt-8 px-4">
      <h3
        class="text-lg font-semibold text-blue-900 dark:text-blue-300 mb-4 text-center"
      >
        Upcoming Talks
      </h3>
      <div class="space-y-3">
        {
          upcomingTalks.map((talk) => (
            <div class="bg-slate-50 hover:bg-blue-50 rounded-lg p-4 border border-gray-200 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600 transition-colors duration-200">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <h4 class="text-sm font-semibold text-blue-900 dark:text-blue-300 mb-1">
                    {talk.title}
                  </h4>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    {talk.event}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-xs text-gray-500 dark:text-gray-500">
                    {talk.date}
                  </p>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    {talk.location}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="text-center mt-8">
      <a
        href="/talks"
        class="inline-flex items-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        <svg
          class="w-4 h-4 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
          ></path>
        </svg>
        View All Talks
      </a>
    </div>
  </div>
</div>

