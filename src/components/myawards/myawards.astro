---
// Awards and Recognitions Component
---

<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mb-2 md:pl-44 md:pr-44"
>
  <div class="flex flex-col pb-10 mt-8">
    <span class="text-slate-900 font-bold text-center md:text-2xl mb-8"
      >Awards & Recognitions</span
    >
    <hr />

    <!-- Main Awards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <!-- Capital Semilla Fondo Emprender -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              Capital Semilla
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Fondo Emprender
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Seed capital funding for innovative entrepreneurship projects.
        </p>
      </div>

      <!-- WorldSkills Colombia -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-amber-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              WorldSkills Colombia
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Bronze Medal - IT/PC
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Bronze medal in Information Technology/PC category.
        </p>
      </div>

      <!-- Campus Party Colombia -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-purple-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              Campus Party Colombia
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Featured Project 2012
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Project recognition showcasing innovative technology solutions.
        </p>
      </div>

      <!-- Apps.co Top 4 -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-blue-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              Apps.co Top 4
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Santander Region
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Top 4 position recognizing digital innovation potential.
        </p>
      </div>

      <!-- NEC Recognition -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-red-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              NEC Colombia
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Innovation Recognition
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Internal recognition for innovation and leadership.
        </p>
      </div>

      <!-- Rappi Recognition -->
      <div
        class="bg-slate-100 hover:bg-blue-900 rounded-md p-4 transition-colors duration-300 group"
      >
        <div class="flex items-center mb-3">
          <div
            class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-3"
          >
            <svg
              class="w-5 h-5 text-orange-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-md font-semibold text-slate-900 group-hover:text-white"
            >
              Rappi
            </h3>
            <p class="text-xs text-gray-600 group-hover:text-gray-200">
              Leadership Recognition
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-700 group-hover:text-gray-200">
          Recognition for technical leadership and innovation.
        </p>
      </div>
    </div>

    <!-- Professional Certifications Section -->
    <div class="mt-8">
      <span class="text-slate-900 font-bold text-sm md:text-xl"
        >Professional Certifications</span
      >
      <hr />
      <div class="flex flex-row items-center mt-2 flex-wrap p-1">
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>Microsoft Certified: Azure Fundamentals (2024)</span>
            </span>
          </div>
        </div>
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>AWS New Voices Foundational Speaker (2025)</span>
            </span>
          </div>
        </div>
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>AWS Community Builder (Frontend & Mobile)</span>
            </span>
          </div>
        </div>
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>Solution Architecture (Udemy)</span>
            </span>
          </div>
        </div>
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>Enterprise Architecture (Udemy)</span>
            </span>
          </div>
        </div>
        <div class="flex flex-col items-center mt-2">
          <div class="flex flex-row items-center">
            <span
              class="bg-slate-100 rounded-md text-xs md:text-sm p-1 ml-2 flex"
            >
              <span
                class="icon-[mdi-light--certificate] w-4 h-4 mr-1 text-gray-500"
              ></span>
              <span>Clean Code C# (Udemy)</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
