---
import Icon from "astro-icon";
import { Image } from "astro:assets";
import Domoteco from "../../assets/img/domoteco.png";
import Intertect from "../../assets/img/intertect.png";
import Motorella from "../../assets/img/motorella.jpeg";
import Nec from "../../assets/img/nec.png";
import Orbit from "../../assets/img/orbit.png";
import Rappi from "../../assets/img/rappi.png";
import Renaware from "../../assets/img/renaware.jpg";

const info = {
  title: "Experience",
  seeAll: {
    text: "See all in",
    url: "https://www.linkedin.com/in/judlup/details/experience/",
    icon: "mdi:linkedin",
  },
  jobs: [
    {
      picture: Renaware,
      role: "Cloud Solutions Architect Lead",
      company: "Rena Ware",
      period: "2023 - Present",
      description: "Leading cloud migration initiatives and architectural solutions",
      location: "Remote / Colombia",
      type: "Full-time",
      details: [
        "Led cloud migration initiatives reducing infrastructure costs by 40%",
        "Designed and implemented Express Architecture methodology",
        "Managed regional technical teams across LATAM",
        "Architected scalable cloud solutions using Azure and AWS",
        "Established best practices for cloud-native development"
      ],
      technologies: ["Azure", "AWS", "Docker", "Terraform", "Microservices", "CI/CD"]
    },
    {
      picture: Rappi,
      role: "Engineer Lead",
      company: "Rappi",
      period: "2022 - 2023",
      description: "Leading engineering teams and microservices architecture",
      location: "Bogotá, Colombia",
      type: "Full-time",
      details: [
        "Led 3 engineering teams with 15+ developers",
        "Architected event-driven microservices for fraud prevention",
        "Improved payment system reliability by 99.9%",
        "Implemented real-time monitoring and alerting systems",
        "Mentored junior developers and conducted technical interviews"
      ],
      technologies: ["Node.js", "React", "Kafka", "Redis", "PostgreSQL", "Docker"]
    },
    {
      picture: Intertect,
      role: "Senior Software Engineer",
      company: "Intertec International",
      period: "2021 - 2022",
      description: "Full-stack development with AWS and .NET technologies",
      location: "Bogotá, Colombia",
      type: "Full-time",
      details: [
        "Developed AWS Lambda functions using .NET Core",
        "Implemented Infrastructure as Code with Terraform",
        "Reduced deployment times by 30% through CI/CD optimization",
        "Built RESTful APIs and microservices architecture",
        "Collaborated with cross-functional teams on agile projects"
      ],
      technologies: [".NET Core", "AWS Lambda", "Terraform", "SQL Server", "Angular"]
    },
    {
      picture: Orbit,
      role: "Senior Fullstack Developer",
      company: "Orbit Group Partner",
      period: "2021 - 2021",
      description: "End-to-end development of web applications",
      location: "Bogotá, Colombia",
      type: "Contract",
      details: [
        "Developed full-stack web applications using modern technologies",
        "Implemented responsive UI/UX designs",
        "Optimized application performance and database queries",
        "Collaborated with design and product teams",
        "Mentored junior developers and conducted code reviews"
      ],
      technologies: ["React", "Node.js", "MongoDB", "Express", "TypeScript"]
    },
    {
      picture: Motorella,
      role: "Software Architect",
      company: "Motorella",
      period: "2019 - 2021",
      description: "Designing scalable software architectures",
      location: "Bogotá, Colombia",
      type: "Full-time",
      details: [
        "Designed and implemented scalable software architectures",
        "Led technical decisions and technology stack selection",
        "Established coding standards and best practices",
        "Architected microservices and API gateways",
        "Collaborated with stakeholders on technical requirements"
      ],
      technologies: ["Java", "Spring Boot", "PostgreSQL", "Docker", "Kubernetes"]
    },
    {
      picture: Nec,
      role: "Software Development Lead",
      company: "Nec de Colombia",
      period: "2019 - 2021",
      description: "Leading development teams and facial recognition solutions",
      location: "Bogotá, Colombia",
      type: "Full-time",
      details: [
        "Led development team of 8 engineers",
        "Developed facial recognition solutions for security systems",
        "Implemented industrial software for manufacturing processes",
        "Managed project timelines and technical deliverables",
        "Received internal recognition for innovation and leadership"
      ],
      technologies: ["Python", "OpenCV", "C++", "SQL Server", "Industrial IoT"]
    },
    {
      picture: Domoteco,
      role: "CEO",
      company: "Domoteco",
      period: "2010 - present",
      description: "Founder and CEO of IoT solutions company",
      location: "Colombia",
      type: "Founder",
      details: [
        "Founded and scaled IoT solutions company from startup to established business",
        "Developed innovative IoT products for industrial automation",
        "Secured seed capital funding from Fondo Emprender",
        "Led product development and market strategy",
        "Managed business operations, sales, and customer relationships"
      ],
      technologies: ["IoT", "Arduino", "Raspberry Pi", "Hardware", "Embedded Systems"]
    },
  ],
};
---

<div class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mb-2 md:pl-44 md:pr-44">
  <div class="flex flex-col pb-10 mt-8">
    <span class="text-slate-900 font-bold text-center md:text-2xl mb-8">{info.title}</span>
    <hr />
  
  <!-- Experience Timeline -->
  <div class="mt-8 space-y-6">
              {
          info.jobs.map((job, index) => (
            <div class="group relative">
              <!-- Timeline Line -->
              <div class="absolute left-8 top-12 w-0.5 h-full bg-gray-200 group-last:hidden"></div>
              <div class="flex items-start space-x-6">
                <!-- Company Logo -->
                <div class="relative flex-shrink-0">
                  <div class="w-16 h-16 bg-white border-4 border-blue-100 rounded-full flex items-center justify-center shadow-lg group-hover:border-blue-300 transition-colors duration-300">
                    <Image
                      src={job.picture}
                      alt={job.company}
                      class="w-10 h-10 rounded-full object-cover"
                    />
                  </div>
                  <!-- Timeline Dot -->
                  <div class="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-4 h-4 bg-blue-500 rounded-full border-4 border-white shadow-lg"></div>
                </div>
                <!-- Job Details -->
                <div class="flex-1 bg-slate-50 hover:bg-blue-50 rounded-lg p-6 transition-all duration-300 cursor-pointer group-hover:shadow-md">
                  <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-900 transition-colors duration-300">
                      {job.role}
                    </h3>
                    <span class="text-sm font-medium text-blue-600 bg-blue-100 px-3 py-1 rounded-full">
                      {job.period}
                    </span>
                  </div>
                  <h4 class="text-md font-semibold text-gray-700 mb-2">
                    {job.company}
                  </h4>
                  <p class="text-sm text-gray-600 leading-relaxed mb-3">
                    {job.description}
                  </p>
                  <!-- Job Meta Info -->
                  <div class="flex items-center space-x-4 mb-4 text-xs text-gray-500">
                    <div class="flex items-center">
                      <Icon name="mdi:map-marker" class="w-4 h-4 mr-1" />
                      {job.location}
                    </div>
                    <div class="flex items-center">
                      <Icon name="mdi:briefcase" class="w-4 h-4 mr-1" />
                      {job.type}
                    </div>
                  </div>
                  <!-- Technologies Preview -->
                  <div class="flex flex-wrap gap-1 mb-4">
                    {job.technologies.slice(0, 3).map((tech) => (
                      <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-1 rounded-full">
                        {tech}
                      </span>
                    ))}
                    {job.technologies.length > 3 && (
                      <span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-1 rounded-full">
                        +{job.technologies.length - 3} more
                      </span>
                    )}
                  </div>

                </div>
              </div>
            </div>
          ))
        }
    </div>
  </div>
  
  <!-- See All Button -->
  <div class="text-center mt-12">
    <a
      href={info.seeAll.url}
      target="_blank"
      class="inline-flex items-center px-4 py-2 text-sm font-medium text-center text-white bg-blue-900 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors duration-300"
    >
      <Icon name={info.seeAll.icon} class="w-4 h-4 mr-2" />
      <span>{info.seeAll.text} LinkedIn</span>
    </a>
  </div>
  </div>
</div>



