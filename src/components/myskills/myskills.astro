<div
  class="w-full mx-w-xl md:max-w-6xl bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mb-2 md:pl-44 md:pr-44"
>
  <div class="flex flex-col pb-10 mt-8">
    <span class="text-slate-900 font-bold text-center md:text-2xl mb-8"
      >{info.title}</span
    >
    {
      info.skills.map((category) => (
        <div class="flex flex-col items-start ml-6 mt-8">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3">
              <Icon
                class="w-4 h-4 text-blue-600"
                name={`${category.skills[0].icon}`}
              />
            </div>
            <span class="text-slate-900 font-bold text-lg md:text-xl">
              {category.category}
            </span>
          </div>
          <hr class="w-full mb-4" />
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 w-full">
            {category.skills.map((skill) => (
              <div class="group bg-slate-100 hover:bg-blue-900 rounded-lg p-3 transition-all duration-300 cursor-pointer">
                <div class="flex items-center space-x-2">
                  <Icon
                    class="w-5 h-5 text-gray-600 group-hover:text-white transition-colors duration-300"
                    name={`${skill.icon}`}
                  />
                  <span class="text-sm font-medium text-gray-700 group-hover:text-white transition-colors duration-300">
                    {skill.name}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
